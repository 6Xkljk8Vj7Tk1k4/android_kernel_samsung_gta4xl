# USB DRD PHY of the Exynos 9610 with its calibration code, as on the 4.14 kernel of gta4xl.
# The files one level up carry newer revisions of the same calibration code for other SoCs
# and define the same symbols, so only one of the two sets is built.
obj-$(CONFIG_PHY_EXYNOS_USBDRD3)	+= phy-exynos-usbdrd3.o phy-exynos-usb3p1.o phy-exynos-usbdp.o
