# A test boot instead of the regular kernel: it resets to the recovery after 90 s
# (/sys/module/gta4xl_early_ramlog/parameters/reset_after moves the timer), every restart,
# panic or hang ends in the recovery, and the system never suspends. For trying a kernel from
# the boot partition with a working recovery as the way back; see
# arch/arm64/kernel/gta4xl_early_ramlog.c.
#   make exynos9611-gta4xl_defconfig gta4xl_test.config
CONFIG_CMDLINE="ignore_loglevel cgroup.memory=nokmem cgroup_disable=pressure gta4xl_test gta4xl_reset_after=90"
